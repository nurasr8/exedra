package "kde-plasma" {
  version = "6.2"
  description = "KDE Plasma 6 desktop (meta package)"
  license = "meta"
  homepage = "https://kde.org/plasma-desktop/"

  depends {
    "plasma-desktop"
    "plasma-workspace"
    "kwin"
    "sddm"
    "breeze"
    "networkmanager"
  }

  install {
    command "true"
  }
}
