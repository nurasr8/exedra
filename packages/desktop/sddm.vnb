package "sddm" {
  version = "0.21.0"
  description = "QML-based X11 and Wayland display manager"
  license = "GPL-2.0-or-later"
  homepage = "https://github.com/sddm/sddm"

  source {
    url = "https://github.com/sddm/sddm/archive/refs/tags/v${version}.tar.gz"
    sha256 = "f895de2683627e969e4849dbfbbb2b500787481ca5ba0de6d6dfdae5f1549abf"
  }

  depends {
    "qt6"
    "pam"
    "systemd"
  }

  makedepends {
    "cmake"
    "gcc"
  }

  build {
    command "cmake -B build -DCMAKE_INSTALL_PREFIX=/usr"
    command "cmake --build build"
  }

  install {
    command "DESTDIR=${DESTDIR} cmake --install build"
  }

  service {
    unit = "sddm.service"
    enable = true
  }
}
