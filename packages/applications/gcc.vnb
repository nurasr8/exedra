package "gcc" {
  version = "15.2.0"
  description = "GNU Compiler Collection"
  license = "GPL-3.0"
  homepage = "https://gcc.gnu.org/"
  source {
    url = "https://ftp.gnu.org/gnu/gcc/gcc-15.2.0/gcc-15.2.0.tar.xz"
    sha256 = "438fd996826b0c82485a29da03a72d71d6e3541a83ec702df4271f6fe025d24e"
  }
  depends {
    "glibc"
    "gmp"
    "mpfr"
    "mpc"
    "zlib"
  }
  makedepends {
    "gcc"
    "make"
    "flex"
    "bison"
  }
  build {
    command "mkdir build && cd build && ../configure --prefix=/usr --enable-languages=c,c++"
    command "make -j$(nproc) -C build"
  }
  install {
    command "make -C build DESTDIR=${destdir} install"
  }
}
