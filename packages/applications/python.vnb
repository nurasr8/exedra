package "python" {
  version = "3.13.7"
  description = "Python programming language"
  license = "PSF-2.0"
  homepage = "https://www.python.org/"
  source {
    url = "https://www.python.org/ftp/python/3.13.7/Python-3.13.7.tar.xz"
    sha256 = "5462f9099dfd30e238def83c71d91897d8caa5ff6ebc7a50f14d4802cdaaa79a"
  }
  depends {
    "glibc"
    "openssl"
    "expat"
    "zlib"
    "libffi"
  }
  makedepends {
    "gcc"
    "make"
    "pkg-config"
  }
  build {
    command "./configure --prefix=/usr --enable-shared"
    command "make -j$(nproc)"
  }
  install {
    command "make DESTDIR=${destdir} install"
  }
}
