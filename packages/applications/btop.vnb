package "btop" {
  version = "1.4.5"
  description = "Resource monitor with modern UI"
  license = "Apache-2.0"
  homepage = "https://github.com/aristocratos/btop"
  source {
    url = "https://github.com/aristocratos/btop/archive/v1.4.5.tar.gz"
    sha256 = "0ffe03d3e26a3e9bbfd5375adf34934137757994f297d6b699a46edd43c3fc02"
  }
  depends {
    "glibc"
    "gcc-libs"
  }
  makedepends {
    "gcc"
    "make"
    "cmake"
  }
  build {
    command "cmake -B build -DCMAKE_PREFIX=/usr"
    command "make -j$(nproc) -C build"
  }
  install {
    command "make -C build DESTDIR=${destdir} PREFIX=/usr install"
  }
}
