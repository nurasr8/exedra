package "firefox" {
  version = "145.0"
  description = "Firefox web browser"
  license = "MPL-2.0"
  homepage = "https://www.mozilla.org/firefox/"
  binary {
    url = "https://download-installer.cdn.mozilla.net/pub/firefox/releases/145.0/linux-x86_64/en-US/firefox-145.0.tar.xz"
    sha256 = "00fb922cda6bab971e02bcbfb77923b0a234388ed7d77c23506ca0a1a61d4a86"
    format = "tar.xz"
  }
  depends {
    "glibc"
    "gtk3"
    "nss"
    "alsa-lib"
    "dbus"
  }
  install {
    command "mkdir -p ${destdir}/opt/firefox ${destdir}/bin"
    command "tar -xf ${srcdir}/firefox-145.0.tar.xz -C ${destdir}/opt/firefox --strip-components=1"
    command "ln -sf ../opt/firefox/firefox ${destdir}/bin/firefox"
  }
}
