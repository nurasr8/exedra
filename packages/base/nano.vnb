package "nano" {
  version = "8.6"
  description = "Small text editor"
  license = "GPL-3.0"
  homepage = "https://www.nano-editor.org/"
  source {
    url = "https://ftp.gnu.org/gnu/nano/nano-8.6.tar.xz"
    sha256 = "f7abfbf0eed5f573ab51bd77a458f32d82f9859c55e9689f819d96fe1437a619"
  }
  depends {
    "glibc"
    "ncurses"
  }
  makedepends {
    "gcc"
    "make"
    "pkg-config"
  }
  build {
    command "./configure --prefix=/usr --sysconfdir=/etc"
    command "make -j$(nproc)"
  }
  install {
    command "make DESTDIR=${destdir} install"
  }
}
