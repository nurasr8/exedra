package "curl" {
  version = "8.17.0"
  description = "URL transfer tool and library"
  license = "MIT"
  homepage = "https://curl.se/"
  source {
    url = "https://curl.se/download/curl-8.17.0.tar.xz"
    sha256 = "955f6e729ad6b3566260e8fef68620e76ba3c31acf0a18524416a185acf77992"
  }
  depends {
    "glibc"
    "openssl"
    "zlib"
    "libssh2"
  }
  makedepends {
    "gcc"
    "make"
    "pkg-config"
  }
  build {
    command "./configure --prefix=/usr --with-openssl"
    command "make -j$(nproc)"
  }
  install {
    command "make DESTDIR=${destdir} install"
  }
}
