package "docker" {
  version = "27.4.1"
  description = "Container runtime (optional service)"
  license = "Apache-2.0"
  homepage = "https://www.docker.com/"

  source {
    url = "https://github.com/moby/moby/archive/refs/tags/v${version}.tar.gz"
    sha256 = "ab0389f1e64f74626667dc773cfc21ac9bb686bacf62b14f15c5b5888ca95313"
  }

  depends {
    "containerd"
    "iptables"
  }

  makedepends {
    "go"
  }

  build {
    command "make VERSION=${version}"
  }

  install {
    command "install -Dm755 build/docker ${DESTDIR}/usr/bin/docker"
    command "install -Dm755 build/dockerd ${DESTDIR}/usr/bin/dockerd"
  }

  service {
    unit = "docker.service"
    enable = false
  }
}
