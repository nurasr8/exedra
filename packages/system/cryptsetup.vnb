package "cryptsetup" {
  version = "2.8.3"
  description = "Disk encryption (LUKS)"
  license = "GPL-2.0"
  homepage = "https://gitlab.com/cryptsetup/cryptsetup"
  source {
    url = "https://www.kernel.org/pub/linux/utils/cryptsetup/v2.8/cryptsetup-2.8.3.tar.xz"
    sha256 = "4a8a23b8b9d1a3250452e40acead4421a03e45a38954ad0595634f4266aa800f"
  }
  depends {
    "glibc"
  }
  makedepends {
    "gcc" "make" "pkg-config"
  }
  build {
    command "./configure --prefix=/usr"
    command "make -j$(nproc)"
  }
  install {
    command "make DESTDIR=${destdir} install"
  }
}
