package "findutils" {
  version = "4.10.0"
  description = "GNU find utilities"
  license = "GPL-3.0"
  homepage = "https://www.gnu.org/software/findutils/"
  source {
    url = "https://ftp.gnu.org/gnu/findutils/findutils-4.10.0.tar.xz"
    sha256 = "1387e0b67ff247d2abde998f90dfbf70c1491391a59ddfecb8ae698789f0a4f5"
  }
  depends {
    "glibc"
  }
  makedepends {
    "gcc"
    "make"
  }
  build {
    command "./configure --prefix=/usr --localstatedir=/var/lib/locate"
    command "make -j$(nproc)"
  }
  install {
    command "make DESTDIR=${destdir} install"
  }
}
