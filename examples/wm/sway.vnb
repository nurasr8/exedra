package "sway" {
  version = "1.10"
  description = "i3-compatible Wayland compositor"
  license = "MIT"
  homepage = "https://swaywm.org/"

  source {
    url = "https://github.com/swaywm/sway/archive/refs/tags/${version}.tar.gz"
    sha256 = "3f15f8f96238d2f7a7b44dbcd132de6c81b2c06cc3b073f195f07f7105072ccf"
  }

  depends {
    "wayland"
    "wlroots"
  }

  makedepends {
    "meson"
    "ninja"
    "gcc"
  }

  build {
    command "meson setup build --prefix=/usr"
    command "ninja -C build"
  }

  install {
    command "DESTDIR=${DESTDIR} ninja -C build install"
  }
}
