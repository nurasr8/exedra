package "sddm-theme-maya" {
  version = "0.21.0"
  description = "Maya SDDM theme (bundled upstream)"
  license = "GPL-2.0-or-later"
  homepage = "https://github.com/sddm/sddm"

  source {
    url = "https://github.com/sddm/sddm/archive/refs/tags/v${version}.tar.gz"
    sha256 = "f895de2683627e969e4849dbfbbb2b500787481ca5ba0de6d6dfdae5f1549abf"
  }

  depends {
    "sddm"
  }

  install {
    command "mkdir -p ${DESTDIR}/usr/share/sddm/themes/maya"
    command "cp -r ${srcdir}/data/themes/maya/* ${DESTDIR}/usr/share/sddm/themes/maya/"
  }
}
