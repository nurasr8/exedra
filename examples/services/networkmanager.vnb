package "networkmanager" {
  version = "1.48.10"
  description = "Network connection manager"
  license = "GPL-2.0-or-later"
  homepage = "https://networkmanager.dev/"

  source {
    url = "https://download.gnome.org/sources/NetworkManager/1.48/NetworkManager-${version}.tar.xz"
    sha256 = "5dc188fdffcf2d23c89d34b1e6319a6b20203e12eaec24b30037b7ea8ac8c613"
  }

  depends {
    "systemd"
    "dbus"
  }

  makedepends {
    "meson"
    "ninja"
    "gcc"
  }

  build {
    command "meson setup build --prefix=/usr"
    command "ninja -C build"
  }

  install {
    command "DESTDIR=${DESTDIR} ninja -C build install"
  }

  service {
    unit = "NetworkManager.service"
    enable = true
  }
}
