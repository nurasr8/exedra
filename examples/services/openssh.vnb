package "openssh" {
  version = "9.9p1"
  description = "OpenSSH remote login client and server"
  license = "BSD"
  homepage = "https://www.openssh.com/"

  source {
    url = "https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-${version}.tar.gz"
    sha256 = "b343fbcdbff87f15b1986e6e15d6d4fc9a7d36066be6b7fb507087ba8f966c02"
  }

  depends {
    "openssl"
    "pam"
  }

  makedepends {
    "gcc"
    "make"
  }

  build {
    command "./configure --prefix=/usr --sysconfdir=/etc/ssh"
    command "make"
  }

  install {
    command "make DESTDIR=${DESTDIR} install"
  }

  service {
    unit = "sshd.service"
    enable = true
  }
}
