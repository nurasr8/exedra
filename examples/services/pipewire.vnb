package "pipewire" {
  version = "1.2.7"
  description = "Multimedia server for audio and video"
  license = "MIT"
  homepage = "https://pipewire.org/"

  source {
    url = "https://github.com/PipeWire/pipewire/archive/refs/tags/${version}.tar.gz"
    sha256 = "e75568ed18bcbe75e9779af57cb9cc256fd7ebfaadc12bb347a0717055d1d3a9"
  }

  depends {
    "dbus"
    "alsa-lib"
  }

  makedepends {
    "meson"
    "ninja"
    "gcc"
  }

  build {
    command "meson setup build --prefix=/usr"
    command "ninja -C build"
  }

  install {
    command "DESTDIR=${DESTDIR} ninja -C build install"
  }

  service {
    unit = "pipewire.service"
    enable = true
  }
}
