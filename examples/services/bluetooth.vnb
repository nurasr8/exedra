package "bluez" {
  version = "5.79"
  description = "Bluetooth protocol stack"
  license = "GPL-2.0-or-later"
  homepage = "https://www.bluez.org/"

  source {
    url = "https://www.kernel.org/pub/linux/bluetooth/bluez-${version}.tar.xz"
    sha256 = "4164a5303a9f71c70f48c03ff60be34231b568d93a9ad5e79928d34e6aa0ea8a"
  }

  depends {
    "dbus"
    "systemd"
  }

  makedepends {
    "gcc"
    "make"
  }

  build {
    command "./configure --prefix=/usr --enable-systemd"
    command "make"
  }

  install {
    command "make DESTDIR=${DESTDIR} install"
  }

  service {
    unit = "bluetooth.service"
    enable = true
  }
}
