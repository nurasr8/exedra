package "wireplumber" {
  version = "0.5.6"
  description = "Session manager for PipeWire"
  license = "MIT"
  homepage = "https://pipewire.pages.freedesktop.org/wireplumber/"

  source {
    url = "https://github.com/PipeWire/wireplumber/archive/refs/tags/${version}.tar.gz"
    sha256 = "ce7b7217d880bed1438e408ea412716a259cb46b09f597bfd652a577dc60185c"
  }

  depends {
    "pipewire"
    "dbus"
  }

  makedepends {
    "meson"
    "ninja"
    "gcc"
  }

  build {
    command "meson setup build --prefix=/usr"
    command "ninja -C build"
  }

  install {
    command "DESTDIR=${DESTDIR} ninja -C build install"
  }

  service {
    unit = "wireplumber.service"
    enable = true
  }
}
