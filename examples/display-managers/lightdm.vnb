package "lightdm" {
  version = "1.32.0"
  description = "Lightweight display manager"
  license = "GPL-3.0-or-later"
  homepage = "https://github.com/canonical/lightdm"

  source {
    url = "https://github.com/canonical/lightdm/archive/refs/tags/${version}.tar.gz"
    sha256 = "6dbcd58332abdc113a7a345c22027c9e485ada802706c6b7fbf5f410464e53e3"
  }

  depends {
    "pam"
    "xorg-server"
  }

  makedepends {
    "meson"
    "ninja"
    "gcc"
  }

  build {
    command "meson setup build --prefix=/usr"
    command "ninja -C build"
  }

  install {
    command "DESTDIR=${DESTDIR} ninja -C build install"
  }

  service {
    unit = "lightdm.service"
    enable = true
  }
}
