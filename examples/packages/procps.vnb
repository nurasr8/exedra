package "procps" {
  version = "4.0.5"
  description = "Process monitoring utilities"
  license = "GPL-2.0"
  homepage = "https://gitlab.com/procps-ng/procps"
  source {
    url = "https://sourceforge.net/projects/procps-ng/files/Production/procps-ng-4.0.5.tar.xz/download"
    sha256 = "c2e6d193cc78f84cd6ddb72aaf6d5c6a9162f0470e5992092057f5ff518562fa"
  }
  depends {
    "glibc"
    "ncurses"
  }
  makedepends {
    "gcc"
    "make"
    "pkg-config"
  }
  build {
    command "./configure --prefix=/usr --exec-prefix=/"
    command "make -j$(nproc)"
  }
  install {
    command "make DESTDIR=${destdir} install"
  }
}
