package "fastfetch" {
  version = "2.52.0"
  description = "Fast system information tool"
  license = "MIT"
  homepage = "https://github.com/fastfetch-cli/fastfetch"
  source {
    url = "https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/2.52.0.tar.gz"
    sha256 = "6199c4cacc0b411fde7ec6c66d12829459284c6cdfb4bacce7b535190d5cd94c"
  }
  depends {
    "glibc"
  }
  makedepends {
    "gcc"
    "make"
    "cmake"
    "pkg-config"
  }
  build {
    command "cmake -B build -DCMAKE_INSTALL_PREFIX=/usr"
    command "cmake --build build -j$(nproc)"
  }
  install {
    command "DESTDIR=${destdir} cmake --install build"
  }
}
