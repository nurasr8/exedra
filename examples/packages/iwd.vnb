package "iwd" {
  version = "3.12"
  description = "Wireless daemon"
  license = "LGPL-2.1"
  homepage = "https://iwd.wiki.kernel.org/"
  source {
    url = "https://www.kernel.org/pub/linux/network/wireless/iwd-3.12.tar.xz"
    sha256 = "d89a5e45c7180170e19be828f9e944a768c593758094fc57a358d0e7c4cb1a49"
  }
  depends {
    "glibc" "ell" "readline"
  }
  makedepends {
    "gcc" "meson" "ninja" "pkg-config"
  }
  build {
    command "meson setup ${builddir} --prefix=/usr"
    command "ninja -C ${builddir}"
  }
  install {
    command "DESTDIR=${destdir} ninja -C ${builddir} install"
  }
}
