package "sudo" {
  version = "1.9.17p1"
  description = "Run commands as root"
  license = "ISC"
  homepage = "https://www.sudo.ws/"
  source {
    url = "https://www.sudo.ws/dist/sudo-1.9.17p1.tar.gz"
    sha256 = "ff607ea717072197738a78f778692cd6df9a7e3e404565f51de063ca27455d32"
  }
  depends {
    "glibc"
    "pam"
    "zlib"
  }
  makedepends {
    "gcc"
    "make"
  }
  build {
    command "./configure --prefix=/usr --with-env-editor"
    command "make -j$(nproc)"
  }
  install {
    command "make DESTDIR=${destdir} install"
  }
}
