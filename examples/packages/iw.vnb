package "iw" {
  version = "6.17"
  description = "Wireless configuration tool"
  license = "GPL-2.0"
  homepage = "https://wireless.wiki.kernel.org/en/users/documentation/iw"
  source {
    url = "https://www.kernel.org/pub/software/network/iw/iw-6.17.tar.xz"
    sha256 = "7d182e498289ab39b257da6780d562e415377107f50358ee5b55b8cfe40b1e33"
  }
  depends {
    "glibc"
  }
  makedepends {
    "gcc" "make" "pkg-config"
  }
  build {
    command "make -j$(nproc)"
  }
  install {
    command "make DESTDIR=${destdir} PREFIX=/usr install"
  }
}
