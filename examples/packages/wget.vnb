package "wget" {
  version = "1.25.0"
  description = "Network file downloader"
  license = "GPL-3.0"
  homepage = "https://www.gnu.org/software/wget/"
  source {
    url = "https://ftp.gnu.org/gnu/wget/wget-1.25.0.tar.gz"
    sha256 = "766e48423e79359ea31e41db9e5c289675947a7fcf2efdcedb726ac9d0da3784"
  }
  depends {
    "glibc"
    "openssl"
    "pcre2"
    "zlib"
  }
  makedepends {
    "gcc"
    "make"
    "pkg-config"
  }
  build {
    command "./configure --prefix=/usr --with-ssl=openssl"
    command "make -j$(nproc)"
  }
  install {
    command "make DESTDIR=${destdir} install"
  }
}
