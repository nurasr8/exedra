package "iproute2" {
  version = "6.18.0"
  description = "IP routing utilities"
  license = "GPL-2.0"
  homepage = "https://www.kernel.org/pub/linux/utils/net/iproute2/"
  source {
    url = "https://www.kernel.org/pub/linux/utils/net/iproute2/iproute2-6.18.0.tar.xz"
    sha256 = "6ba520e1975e4c50dc931eeae91ea37c198b8a173744885f8895b84325f9d456"
  }
  depends {
    "glibc"
    "libcap"
    "iptables"
    "elfutils"
  }
  makedepends {
    "gcc"
    "make"
    "pkg-config"
    "bison"
    "flex"
  }
  build {
    command "./configure --prefix=/usr"
    command "make -j$(nproc)"
  }
  install {
    command "make DESTDIR=${destdir} PREFIX=/usr install"
  }
}
