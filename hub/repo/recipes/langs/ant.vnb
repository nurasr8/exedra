package "ant" {
  version = "1.10.15"
  description = "Ant"
  license = "Apache-2.0"
  homepage = "https://ant.apache.org"
  binary {
    url = "https://dlcdn.apache.org/ant/binaries/apache-ant-1.10.15-bin.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/ant ${destdir}/bin"
    command "tar -xf ${srcdir}/apache-ant-1.10.15-bin.tar.gz -C ${destdir}/opt/ant --strip-components=1"
    command "chmod +x ${destdir}/opt/ant/bin/ant"
    command "ln -sf ../opt/ant/bin/ant ${destdir}/bin/ant"
  }
}
