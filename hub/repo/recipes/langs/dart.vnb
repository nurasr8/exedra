package "dart" {
  version = "3.9.2"
  description = "Dart SDK"
  license = "BSD-3"
  homepage = "https://dart.dev"
  binary {
    url = "https://storage.googleapis.com/dart-archive/channels/stable/release/3.9.2/sdk/dartsdk-linux-x64-release.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./dart-sdk/bin/dart ${destdir}/bin/dart"
    command "chmod +x ${destdir}/bin/dart"
  }
}
