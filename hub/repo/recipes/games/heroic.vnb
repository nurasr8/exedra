package "heroic" {
  version = "2.18.1"
  description = "Heroic launcher"
  license = "GPL-3.0"
  homepage = "https://heroicgameslauncher.com"
  binary {
    url = "https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/releases/download/v2.18.1/Heroic-2.18.1-linux-x86_64.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/heroic ${destdir}/bin"
    command "cp ${srcdir}/Heroic-2.18.1-linux-x86_64.AppImage ${destdir}/opt/heroic/heroic.AppImage"
    command "chmod +x ${destdir}/opt/heroic/heroic.AppImage"
    command "ln -sf ../opt/heroic/heroic.AppImage ${destdir}/bin/heroic"
  }
}
