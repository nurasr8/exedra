package "teeworlds" {
  version = "0.7.5"
  description = "Teeworlds"
  license = "BSD-3"
  homepage = "https://teeworlds.com"
  binary {
    url = "https://www.teeworlds.com/files/teeworlds-0.7.5-linux_x86_64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/teeworlds ${destdir}/bin"
    command "tar -xf ${srcdir}/teeworlds-0.7.5-linux_x86_64.tar.gz -C ${destdir}/opt/teeworlds --strip-components=1"
    command "chmod +x ${destdir}/opt/teeworlds/teeworlds"
    command "ln -sf ../opt/teeworlds/teeworlds ${destdir}/bin/teeworlds"
  }
}
