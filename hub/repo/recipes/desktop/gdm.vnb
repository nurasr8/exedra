package "gdm" {
  version = "46.2"
  description = "GNOME display manager"
  license = "GPL-2.0-or-later"
  homepage = "https://wiki.gnome.org/Projects/GDM"

  source {
    url = "https://download.gnome.org/sources/gdm/46/gdm-${version}.tar.xz"
    sha256 = "4ee345422a16537150cd842450cda52b2ca86984bc51ee20cdc025dcf4bd268b"
  }

  depends {
    "gnome-shell"
  }

  makedepends {
    "meson"
    "ninja"
    "gcc"
  }

  build {
    command "meson setup build --prefix=/usr"
    command "ninja -C build"
  }

  install {
    command "DESTDIR=${DESTDIR} ninja -C build install"
  }

  service {
    unit = "gdm.service"
    enable = true
  }
}
