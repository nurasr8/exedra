package "borgbackup" {
  version = "1.4.5"
  description = "BorgBackup"
  license = "BSD-3"
  homepage = "https://borgbackup.org"
  binary {
    url = "https://github.com/borgbackup/borg/releases/download/1.4.5/borg-linux-glibc231-x86_64"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./borg-linux-glibc231-x86_64 ${destdir}/bin/borgbackup"
    command "chmod +x ${destdir}/bin/borgbackup"
  }
}
