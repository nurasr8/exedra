package "sddm-theme-sugar-candy" {
  version = "2.1"
  description = "Sugar Candy SDDM theme"
  license = "GPL-3.0-or-later"
  homepage = "https://github.com/Kangie/sddm-sugar-candy"

  source {
    url = "https://github.com/Kangie/sddm-sugar-candy/archive/refs/heads/master.tar.gz"
    sha256 = "8258de67e02e0e9bf57ce57d160ba34f9bf37730ff1dc75cd67acd80186be76b"
  }

  depends {
    "sddm"
  }

  install {
    command "mkdir -p ${DESTDIR}/usr/share/sddm/themes/sugar-candy"
    command "cp -r ${srcdir}/* ${DESTDIR}/usr/share/sddm/themes/sugar-candy/"
  }
}
