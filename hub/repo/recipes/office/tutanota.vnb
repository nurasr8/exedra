package "tutanota" {
  version = "360.260922.0"
  description = "Tuta mail"
  license = "GPL-3.0"
  homepage = "https://tuta.com"
  binary {
    url = "https://github.com/tutao/tutanota/releases/download/tutanota-desktop-release-360.260922.0/tutanota-desktop-linux.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/tutanota ${destdir}/bin"
    command "cp ${srcdir}/tutanota-desktop-linux.AppImage ${destdir}/opt/tutanota/tutanota.AppImage"
    command "chmod +x ${destdir}/opt/tutanota/tutanota.AppImage"
    command "ln -sf ../opt/tutanota/tutanota.AppImage ${destdir}/bin/tuta"
  }
}
