package "sublime-text" {
  version = "4192"
  description = "Sublime Text"
  license = "proprietary"
  homepage = "https://www.sublimetext.com"
  binary {
    url = "https://download.sublimetext.com/sublime_text_build_4192_x64.tar.xz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/sublime-text ${destdir}/bin"
    command "tar -xf ${srcdir}/sublime_text_build_4192_x64.tar.xz -C ${destdir}/opt/sublime-text"
    command "chmod +x ${destdir}/opt/sublime-text/sublime_text/sublime_text"
    command "ln -sf ../opt/sublime-text/sublime_text/sublime_text ${destdir}/bin/sublime-text"
  }
}
