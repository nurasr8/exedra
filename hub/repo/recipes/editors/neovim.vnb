package "neovim" {
  version = "0.11.5"
  description = "Neovim"
  license = "Apache-2.0"
  homepage = "https://neovim.io"
  binary {
    url = "https://github.com/neovim/neovim/releases/download/v0.11.5/nvim-linux-x86_64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/neovim ${destdir}/bin"
    command "tar -xf ${srcdir}/nvim-linux-x86_64.tar.gz -C ${destdir}/opt/neovim --strip-components=1"
    command "chmod +x ${destdir}/opt/neovim/bin/nvim"
    command "ln -sf ../opt/neovim/bin/nvim ${destdir}/bin/neovim"
  }
}
