package "ethtool" {
  version = "7.1"
  description = "Ethernet diagnostics"
  license = "GPL-2.0"
  homepage = "https://www.kernel.org/pub/software/network/ethtool/"
  source {
    url = "https://www.kernel.org/pub/software/network/ethtool/ethtool-7.1.tar.xz"
    sha256 = "4d78c26edc0255bc92f4b995b5fd66108d75ff966ed4694f6025a6d370bc2496"
  }
  depends {
    "glibc"
  }
  makedepends {
    "gcc" "make"
  }
  build {
    command "./configure --prefix=/usr"
    command "make -j$(nproc)"
  }
  install {
    command "make DESTDIR=${destdir} install"
  }
}
