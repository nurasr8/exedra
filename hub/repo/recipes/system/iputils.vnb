package "iputils" {
  version = "20250605"
  description = "Network monitoring tools including ping"
  license = "BSD-3-Clause"
  homepage = "https://github.com/iputils/iputils"
  source {
    url = "https://github.com/iputils/iputils/archive/20250605.tar.gz"
    sha256 = "19e680c9eef8c079da4da37040b5f5453763205b4edfb1e2c114de77908927e4"
  }
  depends {
    "glibc"
    "libcap"
    "libidn2"
  }
  makedepends {
    "gcc"
    "make"
    "meson"
    "ninja"
    "pkg-config"
  }
  build {
    command "meson setup build --prefix=/usr"
    command "ninja -C build"
  }
  install {
    command "DESTDIR=${destdir} ninja -C build install"
  }
}
