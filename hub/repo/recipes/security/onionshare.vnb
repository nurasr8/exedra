package "onionshare" {
  version = "2.6.3"
  description = "OnionShare"
  license = "GPL-3.0"
  homepage = "https://onionshare.org"
  binary {
    url = "https://github.com/onionshare/onionshare/releases/download/v2.6.3/OnionShare-2.6.3.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/onionshare ${destdir}/bin"
    command "cp ${srcdir}/OnionShare-2.6.3.AppImage ${destdir}/opt/onionshare/onionshare.AppImage"
    command "chmod +x ${destdir}/opt/onionshare/onionshare.AppImage"
    command "ln -sf ../opt/onionshare/onionshare.AppImage ${destdir}/bin/onionshare"
  }
}
