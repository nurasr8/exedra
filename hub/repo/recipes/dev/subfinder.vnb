package "subfinder" {
  version = "2.16.0"
  description = "subfinder"
  license = "MIT"
  homepage = "https://github.com/projectdiscovery/subfinder"
  binary {
    url = "https://github.com/projectdiscovery/subfinder/releases/download/v2.16.0/subfinder_2.16.0_linux_amd64.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./subfinder ${destdir}/bin/subfinder"
    command "chmod +x ${destdir}/bin/subfinder"
  }
}
