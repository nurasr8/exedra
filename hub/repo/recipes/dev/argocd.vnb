package "argocd" {
  version = "3.1.7"
  description = "Argo CD CLI"
  license = "Apache-2.0"
  homepage = "https://argo-cd.readthedocs.io"
  binary {
    url = "https://github.com/argoproj/argo-cd/releases/download/v3.1.7/argocd-linux-amd64"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./argocd-linux-amd64 ${destdir}/bin/argocd"
    command "chmod +x ${destdir}/bin/argocd"
  }
}
