package "crictl" {
  version = "1.34.1"
  description = "crictl"
  license = "Apache-2.0"
  homepage = "https://github.com/kubernetes-sigs/cri-tools"
  binary {
    url = "https://github.com/kubernetes-sigs/cri-tools/releases/download/v1.34.1/crictl-v1.34.1-linux-amd64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/crictl ${destdir}/bin"
    command "tar -xf ${srcdir}/crictl-v1.34.1-linux-amd64.tar.gz -C ${destdir}/opt/crictl"
    command "chmod +x ${destdir}/opt/crictl/crictl"
    command "ln -sf ../opt/crictl/crictl ${destdir}/bin/crictl"
  }
}
