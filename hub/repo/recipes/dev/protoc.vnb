package "protoc" {
  version = "32.1"
  description = "protoc"
  license = "BSD-3"
  homepage = "https://github.com/protocolbuffers/protobuf"
  binary {
    url = "https://github.com/protocolbuffers/protobuf/releases/download/v32.1/protoc-32.1-linux-x86_64.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./bin/protoc ${destdir}/bin/protoc"
    command "chmod +x ${destdir}/bin/protoc"
  }
}
