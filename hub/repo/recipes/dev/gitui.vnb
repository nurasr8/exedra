package "gitui" {
  version = "0.28.1"
  description = "gitui"
  license = "MIT"
  homepage = "https://github.com/gitui-org/gitui"
  binary {
    url = "https://github.com/gitui-org/gitui/releases/download/v0.28.1/gitui-linux-x86_64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/gitui ${destdir}/bin"
    command "tar -xf ${srcdir}/gitui-linux-x86_64.tar.gz -C ${destdir}/opt/gitui"
    command "chmod +x ${destdir}/opt/gitui/gitui"
    command "ln -sf ../opt/gitui/gitui ${destdir}/bin/gitui"
  }
}
