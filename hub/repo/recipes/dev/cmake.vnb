package "cmake" {
  version = "4.2.1"
  description = "CMake"
  license = "BSD-3"
  homepage = "https://cmake.org"
  binary {
    url = "https://github.com/Kitware/CMake/releases/download/v4.2.1/cmake-4.2.1-linux-x86_64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/cmake ${destdir}/bin"
    command "tar -xf ${srcdir}/cmake-4.2.1-linux-x86_64.tar.gz -C ${destdir}/opt/cmake --strip-components=1"
    command "chmod +x ${destdir}/opt/cmake/bin/cmake"
    command "ln -sf ../opt/cmake/bin/cmake ${destdir}/bin/cmake"
    command "chmod +x ${destdir}/opt/cmake/bin/ctest"
    command "ln -sf ../opt/cmake/bin/ctest ${destdir}/bin/ctest"
    command "chmod +x ${destdir}/opt/cmake/bin/cpack"
    command "ln -sf ../opt/cmake/bin/cpack ${destdir}/bin/cpack"
  }
}
