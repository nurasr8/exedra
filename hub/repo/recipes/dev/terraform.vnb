package "terraform" {
  version = "1.13.3"
  description = "Terraform"
  license = "BSL-1.1"
  homepage = "https://terraform.io"
  binary {
    url = "https://releases.hashicorp.com/terraform/1.13.3/terraform_1.13.3_linux_amd64.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./terraform ${destdir}/bin/terraform"
    command "chmod +x ${destdir}/bin/terraform"
  }
}
