package "overmind" {
  version = "2.5.1"
  description = "Overmind procman"
  license = "MIT"
  homepage = "https://github.com/DarthSim/overmind"
  binary {
    url = "https://github.com/DarthSim/overmind/releases/download/v2.5.1/overmind-v2.5.1-linux-amd64.gz"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./overmind-v2.5.1-linux-amd64 ${destdir}/bin/overmind"
    command "chmod +x ${destdir}/bin/overmind"
  }
}
