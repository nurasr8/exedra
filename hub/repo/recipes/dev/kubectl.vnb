package "kubectl" {
  version = "1.34.2"
  description = "kubectl"
  license = "Apache-2.0"
  homepage = "https://kubernetes.io"
  binary {
    url = "https://dl.k8s.io/release/v1.34.2/bin/linux/amd64/kubectl"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./kubectl ${destdir}/bin/kubectl"
    command "chmod +x ${destdir}/bin/kubectl"
  }
}
