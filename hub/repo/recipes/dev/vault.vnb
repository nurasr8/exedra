package "vault" {
  version = "1.20.0"
  description = "Vault"
  license = "BSL-1.1"
  homepage = "https://vaultproject.io"
  binary {
    url = "https://releases.hashicorp.com/vault/1.20.0/vault_1.20.0_linux_amd64.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./vault ${destdir}/bin/vault"
    command "chmod +x ${destdir}/bin/vault"
  }
}
