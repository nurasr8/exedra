package "k3s" {
  version = "1.34.2"
  description = "k3s"
  license = "Apache-2.0"
  homepage = "https://k3s.io"
  binary {
    url = "https://github.com/k3s-io/k3s/releases/download/v1.34.2%2Bk3s1/k3s"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./k3s ${destdir}/bin/k3s"
    command "chmod +x ${destdir}/bin/k3s"
  }
}
