package "jan" {
  version = "0.8.4"
  description = "Jan AI chat"
  license = "AGPL-3.0"
  homepage = "https://jan.ai"
  binary {
    url = "https://github.com/menloresearch/jan/releases/download/v0.8.4/Jan_0.8.4_amd64.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/jan ${destdir}/bin"
    command "cp ${srcdir}/Jan_0.8.4_amd64.AppImage ${destdir}/opt/jan/jan.AppImage"
    command "chmod +x ${destdir}/opt/jan/jan.AppImage"
    command "ln -sf ../opt/jan/jan.AppImage ${destdir}/bin/jan"
  }
}
