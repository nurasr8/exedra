package "pipewire" {
  version = "1.4.7"
  description = "Multimedia server for audio and video"
  license = "MIT"
  homepage = "https://pipewire.org/"

  source {
    url = "https://gitlab.freedesktop.org/pipewire/pipewire/-/archive/1.4.7/pipewire-1.4.7.tar.gz"
    sha256 = "9d54f025e1e7ae73b980a6c8be2e8e6387e24d554d58478d6495734ce1ee5a93"
  }

  depends {
    "dbus"
    "alsa-lib"
  }

  makedepends {
    "meson"
    "ninja"
    "gcc"
  }

  build {
    command "meson setup build --prefix=/usr"
    command "ninja -C build"
  }

  install {
    command "DESTDIR=${DESTDIR} ninja -C build install"
  }

  service {
    unit = "pipewire.service"
    enable = true
  }
}
