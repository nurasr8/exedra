package "mkcert" {
  version = "1.4.9"
  description = "mkcert certs"
  license = "MPL-2.0"
  homepage = "https://github.com/FiloSottile/mkcert"
  binary {
    url = "https://github.com/FiloSottile/mkcert/releases/download/v1.4.9/mkcert-v1.4.9-linux-amd64"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./mkcert-v1.4.9-linux-amd64 ${destdir}/bin/mkcert"
    command "chmod +x ${destdir}/bin/mkcert"
  }
}
