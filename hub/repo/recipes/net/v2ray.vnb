package "v2ray" {
  version = "5.38.0"
  description = "V2Ray"
  license = "MIT"
  homepage = "https://v2fly.org"
  binary {
    url = "https://github.com/v2fly/v2ray-core/releases/latest/download/v2ray-linux-64.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./v2ray ${destdir}/bin/v2ray"
    command "chmod +x ${destdir}/bin/v2ray"
  }
}
