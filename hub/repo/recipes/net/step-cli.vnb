package "step-cli" {
  version = "0.31.0"
  description = "step CLI"
  license = "Apache-2.0"
  homepage = "https://smallstep.com/cli"
  binary {
    url = "https://github.com/smallstep/cli/releases/download/v0.31.0/step_linux_amd64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/step-cli ${destdir}/bin"
    command "tar -xf ${srcdir}/step_linux_amd64.tar.gz -C ${destdir}/opt/step-cli"
    command "chmod +x ${destdir}/opt/step-cli/step"
    command "ln -sf ../opt/step-cli/step ${destdir}/bin/step-cli"
  }
}
