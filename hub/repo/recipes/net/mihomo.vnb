package "mihomo" {
  version = "1.19.13"
  description = "Mihomo proxy"
  license = "GPL-3.0"
  homepage = "https://github.com/MetaCubeX/mihomo"
  binary {
    url = "https://github.com/MetaCubeX/mihomo/releases/download/v1.19.13/mihomo-linux-amd64-v1.19.13.gz"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./mihomo-linux-amd64-v1.19.13 ${destdir}/bin/mihomo"
    command "chmod +x ${destdir}/bin/mihomo"
  }
}
