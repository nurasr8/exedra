package "xray" {
  version = "26.2.0"
  description = "Xray-core"
  license = "MPL-2.0"
  homepage = "https://github.com/XTLS/Xray-core"
  binary {
    url = "https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-64.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./xray ${destdir}/bin/xray"
    command "chmod +x ${destdir}/bin/xray"
  }
}
