package "posting" {
  version = "3.3.0"
  description = "Posting API client"
  license = "MIT"
  homepage = "https://github.com/darrenburns/posting"
  binary {
    url = "https://github.com/darrenburns/posting/releases/download/3.3.0/posting_3.3.0_linux_amd64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/posting ${destdir}/bin"
    command "tar -xf ${srcdir}/posting_3.3.0_linux_amd64.tar.gz -C ${destdir}/opt/posting"
    command "chmod +x ${destdir}/opt/posting/posting"
    command "ln -sf ../opt/posting/posting ${destdir}/bin/posting"
  }
}
