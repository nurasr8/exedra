package "k6" {
  version = "1.3.0"
  description = "k6 load testing"
  license = "AGPL-3.0"
  homepage = "https://k6.io"
  binary {
    url = "https://github.com/grafana/k6/releases/download/v1.3.0/k6-v1.3.0-linux-amd64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/k6 ${destdir}/bin"
    command "tar -xf ${srcdir}/k6-v1.3.0-linux-amd64.tar.gz -C ${destdir}/opt/k6"
    command "chmod +x ${destdir}/opt/k6/k6"
    command "ln -sf ../opt/k6/k6 ${destdir}/bin/k6"
  }
}
