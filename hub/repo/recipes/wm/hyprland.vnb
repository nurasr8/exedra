package "hyprland" {
  version = "0.45.2"
  description = "Dynamic tiling Wayland compositor"
  license = "BSD-3-Clause"
  homepage = "https://hyprland.org/"

  source {
    url = "https://github.com/hyprwm/Hyprland/archive/refs/tags/v${version}.tar.gz"
    sha256 = "ad54556ed694e00dc7b433a3cc916c8f5b9633f0b290d2d6f48f2bcdf2886d28"
  }

  depends {
    "wayland"
    "cairo"
    "pango"
    "pipewire"
  }

  makedepends {
    "cmake"
    "meson"
    "ninja"
    "gcc"
  }

  build {
    command "cmake -B build --prefix=/usr"
    command "cmake --build build"
  }

  install {
    command "cmake --install build --prefix ${DESTDIR}/usr"
  }
}
