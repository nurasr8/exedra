package "ungoogled-chromium" {
  version = "154.0"
  description = "Ungoogled Chromium"
  license = "BSD-3"
  homepage = "https://ungoogled-software.github.io"
  binary {
    url = "https://github.com/ungoogled-software/ungoogled-chromium-portablelinux/releases/download/154.0.8037.57-1/ungoogled-chromium-154.0.8037.57-1-x86_64.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/ungoogled-chromium ${destdir}/bin"
    command "cp ${srcdir}/ungoogled-chromium-154.0.8037.57-1-x86_64.AppImage ${destdir}/opt/ungoogled-chromium/ungoogled-chromium.AppImage"
    command "chmod +x ${destdir}/opt/ungoogled-chromium/ungoogled-chromium.AppImage"
    command "ln -sf ../opt/ungoogled-chromium/ungoogled-chromium.AppImage ${destdir}/bin/ungoogled-chromium"
  }
}
