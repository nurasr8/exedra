package "zen-browser" {
  version = "1.17"
  description = "Zen Browser"
  license = "MPL-2.0"
  homepage = "https://zen-browser.app"
  binary {
    url = "https://github.com/zen-browser/desktop/releases/latest/download/zen.linux-x86_64.tar.xz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/zen-browser ${destdir}/bin"
    command "tar -xf ${srcdir}/zen.linux-x86_64.tar.xz -C ${destdir}/opt/zen-browser --strip-components=1"
    command "chmod +x ${destdir}/opt/zen-browser/zen"
    command "ln -sf ../opt/zen-browser/zen ${destdir}/bin/zen-browser"
  }
}
