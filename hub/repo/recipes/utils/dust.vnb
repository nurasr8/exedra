package "dust" {
  version = "1.2.3"
  description = "dust du"
  license = "Apache-2.0"
  homepage = "https://github.com/bootandy/dust"
  binary {
    url = "https://github.com/bootandy/dust/releases/download/v1.2.3/dust-v1.2.3-x86_64-unknown-linux-musl.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/dust ${destdir}/bin"
    command "tar -xf ${srcdir}/dust-v1.2.3-x86_64-unknown-linux-musl.tar.gz -C ${destdir}/opt/dust"
    command "chmod +x ${destdir}/opt/dust/dust"
    command "ln -sf ../opt/dust/dust ${destdir}/bin/dust"
  }
}
