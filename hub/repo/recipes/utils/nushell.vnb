package "nushell" {
  version = "0.109.1"
  description = "Nushell"
  license = "MIT"
  homepage = "https://nushell.sh"
  binary {
    url = "https://github.com/nushell/nushell/releases/download/0.109.1/nu-0.109.1-x86_64-unknown-linux-gnu.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/nushell ${destdir}/bin"
    command "tar -xf ${srcdir}/nu-0.109.1-x86_64-unknown-linux-gnu.tar.gz -C ${destdir}/opt/nushell"
    command "chmod +x ${destdir}/opt/nushell/nu"
    command "ln -sf ../opt/nushell/nu ${destdir}/bin/nushell"
  }
}
