package "zenith" {
  version = "0.15.1"
  description = "zenith monitor"
  license = "MIT"
  homepage = "https://github.com/bvaisvil/zenith"
  binary {
    url = "https://github.com/bvaisvil/zenith/releases/download/0.15.1/zenith-Linux-musl-x86_64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/zenith ${destdir}/bin"
    command "tar -xf ${srcdir}/zenith-Linux-musl-x86_64.tar.gz -C ${destdir}/opt/zenith"
    command "chmod +x ${destdir}/opt/zenith/zenith"
    command "ln -sf ../opt/zenith/zenith ${destdir}/bin/zenith"
  }
}
