package "xplr" {
  version = "1.1.0"
  description = "xplr file manager"
  license = "MIT"
  homepage = "https://github.com/sayanarijit/xplr"
  binary {
    url = "https://github.com/sayanarijit/xplr/releases/download/v1.1.0/xplr-v1.1.0-x86_64-unknown-linux-musl.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/xplr ${destdir}/bin"
    command "tar -xf ${srcdir}/xplr-v1.1.0-x86_64-unknown-linux-musl.tar.gz -C ${destdir}/opt/xplr"
    command "chmod +x ${destdir}/opt/xplr/xplr"
    command "ln -sf ../opt/xplr/xplr ${destdir}/bin/xplr"
  }
}
