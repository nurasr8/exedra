package "usql" {
  version = "0.17.1"
  description = "usql SQL"
  license = "MIT"
  homepage = "https://github.com/xo/usql"
  binary {
    url = "https://github.com/xo/usql/releases/download/v0.17.1/usql-0.17.1-linux-amd64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/usql ${destdir}/bin"
    command "tar -xf ${srcdir}/usql-0.17.1-linux-amd64.tar.gz -C ${destdir}/opt/usql"
    command "chmod +x ${destdir}/opt/usql/usql"
    command "ln -sf ../opt/usql/usql ${destdir}/bin/usql"
  }
}
