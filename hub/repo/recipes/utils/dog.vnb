package "dog" {
  version = "0.1.0"
  description = "dog DNS"
  license = "EPL-2.0"
  homepage = "https://github.com/ogham/dog"
  binary {
    url = "https://github.com/ogham/dog/releases/download/v0.1.0/dog-v0.1.0-x86_64-unknown-linux-gnu.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./bin/dog ${destdir}/bin/dog"
    command "chmod +x ${destdir}/bin/dog"
  }
}
