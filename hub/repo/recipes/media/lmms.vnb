package "lmms" {
  version = "1.2.2"
  description = "LMMS music studio"
  license = "GPL-2.0"
  homepage = "https://lmms.io"
  binary {
    url = "https://github.com/LMMS/lmms/releases/download/v1.2.2/lmms-1.2.2-linux-x86_64.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/lmms ${destdir}/bin"
    command "cp ${srcdir}/lmms-1.2.2-linux-x86_64.AppImage ${destdir}/opt/lmms/lmms.AppImage"
    command "chmod +x ${destdir}/opt/lmms/lmms.AppImage"
    command "ln -sf ../opt/lmms/lmms.AppImage ${destdir}/bin/lmms"
  }
}
