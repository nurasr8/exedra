package "readarr" {
  version = "0.4"
  description = "Readarr books"
  license = "GPL-3.0"
  homepage = "https://readarr.com"
  binary {
    url = "https://github.com/Readarr/Readarr/releases/download/v0.4.18.2805/Readarr.develop.0.4.18.2805.linux-core-x64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/readarr ${destdir}/bin"
    command "tar -xf ${srcdir}/Readarr.develop.0.4.18.2805.linux-core-x64.tar.gz -C ${destdir}/opt/readarr"
    command "chmod +x ${destdir}/opt/readarr/Readarr"
    command "ln -sf ../opt/readarr/Readarr ${destdir}/bin/readarr"
  }
}
