package "sonarr" {
  version = "4.0.20"
  description = "Sonarr TV"
  license = "GPL-3.0"
  homepage = "https://sonarr.tv"
  binary {
    url = "https://github.com/Sonarr/Sonarr/releases/download/v4.0.20.3014/Sonarr.main.4.0.20.3014.linux-x64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/sonarr ${destdir}/bin"
    command "tar -xf ${srcdir}/Sonarr.main.4.0.20.3014.linux-x64.tar.gz -C ${destdir}/opt/sonarr"
    command "chmod +x ${destdir}/opt/sonarr/Sonarr"
    command "ln -sf ../opt/sonarr/Sonarr ${destdir}/bin/sonarr"
  }
}
