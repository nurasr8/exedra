package "navidrome" {
  version = "0.64"
  description = "Navidrome music"
  license = "GPL-3.0"
  homepage = "https://navidrome.org"
  binary {
    url = "https://github.com/navidrome/navidrome/releases/download/v0.64.2/navidrome_0.64.2_linux_amd64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/navidrome ${destdir}/bin"
    command "tar -xf ${srcdir}/navidrome_0.64.2_linux_amd64.tar.gz -C ${destdir}/opt/navidrome"
    command "chmod +x ${destdir}/opt/navidrome/navidrome"
    command "ln -sf ../opt/navidrome/navidrome ${destdir}/bin/navidrome"
  }
}
