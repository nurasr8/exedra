package "musescore" {
  version = "4.6.5"
  description = "MuseScore notation"
  license = "GPL-3.0"
  homepage = "https://musescore.org"
  binary {
    url = "https://github.com/musescore/MuseScore/releases/download/v4.6.5/MuseScore-Studio-4.6.5-x86_64.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/musescore ${destdir}/bin"
    command "cp ${srcdir}/MuseScore-Studio-4.6.5-x86_64.AppImage ${destdir}/opt/musescore/musescore.AppImage"
    command "chmod +x ${destdir}/opt/musescore/musescore.AppImage"
    command "ln -sf ../opt/musescore/musescore.AppImage ${destdir}/bin/musescore"
  }
}
