package "hello-venim" {
  version = "0.1.0"
  description = "Test package for Exedra"
  license = "MIT"
  homepage = "https://github.com/nurasr8/exedra"
  makedepends { "gcc" }
  build {
    command "cc ${srcdir}/hello.c -o ${builddir}/hello"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ${builddir}/hello ${destdir}/bin/hello"
  }
}
