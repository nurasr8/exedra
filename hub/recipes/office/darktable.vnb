package "darktable" {
  version = "5.2.0"
  description = "darktable raw photos"
  license = "GPL-3.0"
  homepage = "https://darktable.org"
  binary {
    url = "https://github.com/darktable-org/darktable/releases/download/release-5.2.0/Darktable-5.2.0-x86_64.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/darktable ${destdir}/bin"
    command "cp ${srcdir}/Darktable-5.2.0-x86_64.AppImage ${destdir}/opt/darktable/darktable.AppImage"
    command "chmod +x ${destdir}/opt/darktable/darktable.AppImage"
    command "ln -sf ../opt/darktable/darktable.AppImage ${destdir}/bin/darktable"
  }
}
