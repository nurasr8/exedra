package "libreoffice" {
  version = "26.2.0"
  description = "LibreOffice"
  license = "MPL-2.0"
  homepage = "https://libreoffice.org"
  binary {
    url = "https://download.documentfoundation.org/libreoffice/stable/26.2.0/appimage/LibreOffice-fresh.standard-x86_64.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/libreoffice ${destdir}/bin"
    command "cp ${srcdir}/LibreOffice-fresh.standard-x86_64.AppImage ${destdir}/opt/libreoffice/libreoffice.AppImage"
    command "chmod +x ${destdir}/opt/libreoffice/libreoffice.AppImage"
    command "ln -sf ../opt/libreoffice/libreoffice.AppImage ${destdir}/bin/libreoffice"
  }
}
