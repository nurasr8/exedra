package "koodo-reader" {
  version = "2.9.4"
  description = "Koodo Reader ebooks"
  license = "AGPL-3.0"
  homepage = "https://koodo.960960.xyz"
  binary {
    url = "https://github.com/troyeguo/koodo-reader/releases/download/v2.9.4/Koodo-Reader-2.9.4.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/koodo-reader ${destdir}/bin"
    command "cp ${srcdir}/Koodo-Reader-2.9.4.AppImage ${destdir}/opt/koodo-reader/koodo-reader.AppImage"
    command "chmod +x ${destdir}/opt/koodo-reader/koodo-reader.AppImage"
    command "ln -sf ../opt/koodo-reader/koodo-reader.AppImage ${destdir}/bin/koodo-reader"
  }
}
