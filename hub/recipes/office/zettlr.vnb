package "zettlr" {
  version = "3.4.6"
  description = "Zettlr markdown editor"
  license = "GPL-3.0"
  homepage = "https://zettlr.com"
  binary {
    url = "https://github.com/Zettlr/Zettlr/releases/download/v3.4.6/Zettlr-3.4.6-x86_64.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/zettlr ${destdir}/bin"
    command "cp ${srcdir}/Zettlr-3.4.6-x86_64.AppImage ${destdir}/opt/zettlr/zettlr.AppImage"
    command "chmod +x ${destdir}/opt/zettlr/zettlr.AppImage"
    command "ln -sf ../opt/zettlr/zettlr.AppImage ${destdir}/bin/zettlr"
  }
}
