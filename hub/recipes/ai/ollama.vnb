package "ollama" {
  version = "0.34.4"
  description = "Ollama LLMs"
  license = "MIT"
  homepage = "https://ollama.com"
  binary {
    url = "https://github.com/ollama/ollama/releases/download/v0.34.4/ollama-linux-amd64.tar.zst"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/ollama ${destdir}/bin"
    command "tar -xf ${srcdir}/ollama-linux-amd64.tar.zst -C ${destdir}/opt/ollama"
    command "chmod +x ${destdir}/opt/ollama/bin/ollama"
    command "ln -sf ../opt/ollama/bin/ollama ${destdir}/bin/ollama"
  }
}
