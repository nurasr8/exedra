package "kitty" {
  version = "0.42.2"
  description = "Kitty terminal"
  license = "GPL-3.0"
  homepage = "https://sw.kovidgoyal.net/kitty"
  binary {
    url = "https://sw.kovidgoyal.net/kitty/binary/kitty-0.42.2.x86_64.txz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/kitty ${destdir}/bin"
    command "tar -xf ${srcdir}/kitty-0.42.2.x86_64.txz -C ${destdir}/opt/kitty"
    command "chmod +x ${destdir}/opt/kitty/bin/kitty"
    command "ln -sf ../opt/kitty/bin/kitty ${destdir}/bin/kitty"
  }
}
