package "websocat" {
  version = "1.15.0"
  description = "websocat"
  license = "MIT"
  homepage = "https://github.com/vi/websocat"
  binary {
    url = "https://github.com/vi/websocat/releases/download/v1.15.0/websocat.x86_64-unknown-linux-musl"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./websocat.x86_64-unknown-linux-musl ${destdir}/bin/websocat"
    command "chmod +x ${destdir}/bin/websocat"
  }
}
