package "cloudflared" {
  version = "2025.10.0"
  description = "cloudflared tunnel"
  license = "Apache-2.0"
  homepage = "https://developers.cloudflare.com/cloudflare-one/"
  binary {
    url = "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./cloudflared-linux-amd64 ${destdir}/bin/cloudflared"
    command "chmod +x ${destdir}/bin/cloudflared"
  }
}
