package "gost" {
  version = "2.12.0"
  description = "GOST proxy"
  license = "MIT"
  homepage = "https://github.com/ginuerzh/gost"
  binary {
    url = "https://github.com/ginuerzh/gost/releases/download/v2.12.0/gost_2.12.0_linux_amd64.tar.gz"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./gost_2.12.0_linux_amd64.tar ${destdir}/bin/gost"
    command "chmod +x ${destdir}/bin/gost"
  }
}
