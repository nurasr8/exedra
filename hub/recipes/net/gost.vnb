package "gost" {
  version = "3.2.2"
  description = "GOST proxy"
  license = "MIT"
  homepage = "https://github.com/ginuerzh/gost"
  binary {
    url = "https://github.com/ginuerzh/gost/releases/download/v3.2.2/gost-linux-amd64-3.2.2.gz"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./gost-linux-amd64-3.2.2 ${destdir}/bin/gost"
    command "chmod +x ${destdir}/bin/gost"
  }
}
