package "sing-box" {
  version = "1.12.4"
  description = "sing-box proxy"
  license = "GPL-3.0"
  homepage = "https://sing-box.sagernet.org"
  binary {
    url = "https://github.com/SagerNet/sing-box/releases/download/v1.12.4/sing-box-1.12.4-linux-amd64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/sing-box ${destdir}/bin"
    command "tar -xf ${srcdir}/sing-box-1.12.4-linux-amd64.tar.gz -C ${destdir}/opt/sing-box"
    command "chmod +x ${destdir}/opt/sing-box/sing-box"
    command "ln -sf ../opt/sing-box/sing-box ${destdir}/bin/sing-box"
  }
}
