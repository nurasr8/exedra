package "chisel" {
  version = "1.11.3"
  description = "chisel tunnels"
  license = "MIT"
  homepage = "https://github.com/jpillora/chisel"
  binary {
    url = "https://github.com/jpillora/chisel/releases/download/v1.11.3/chisel_1.11.3_linux_amd64.gz"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./chisel_1.11.3_linux_amd64 ${destdir}/bin/chisel"
    command "chmod +x ${destdir}/bin/chisel"
  }
}
