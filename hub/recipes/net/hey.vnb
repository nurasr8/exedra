package "hey" {
  version = "0.1.4"
  description = "hey load generator"
  license = "Apache-2.0"
  homepage = "https://github.com/rakyll/hey"
  binary {
    url = "https://github.com/rakyll/hey/releases/download/v0.1.4/hey_linux_amd64"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./hey_linux_amd64 ${destdir}/bin/hey"
    command "chmod +x ${destdir}/bin/hey"
  }
}
