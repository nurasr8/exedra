package "nextcloud" {
  version = "34.0.4"
  description = "Nextcloud client"
  license = "GPL-2.0"
  homepage = "https://nextcloud.com"
  binary {
    url = "https://github.com/nextcloud-releases/desktop/releases/download/v34.0.4/Nextcloud-34.0.4-x86_64.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/nextcloud ${destdir}/bin"
    command "cp ${srcdir}/Nextcloud-34.0.4-x86_64.AppImage ${destdir}/opt/nextcloud/nextcloud.AppImage"
    command "chmod +x ${destdir}/opt/nextcloud/nextcloud.AppImage"
    command "ln -sf ../opt/nextcloud/nextcloud.AppImage ${destdir}/bin/nextcloud-client"
  }
}
