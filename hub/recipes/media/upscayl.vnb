package "upscayl" {
  version = "2.15"
  description = "Upscayl upscaler"
  license = "AGPL-3.0"
  homepage = "https://github.com/upscayl/upscayl"
  binary {
    url = "https://github.com/upscayl/upscayl/releases/download/v2.15.0/Upscayl-2.15.0-linux.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/upscayl ${destdir}/bin"
    command "cp ${srcdir}/Upscayl-2.15.0-linux.AppImage ${destdir}/opt/upscayl/upscayl.AppImage"
    command "chmod +x ${destdir}/opt/upscayl/upscayl.AppImage"
    command "ln -sf ../opt/upscayl/upscayl.AppImage ${destdir}/bin/upscayl"
  }
}
