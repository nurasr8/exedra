package "kdenlive" {
  version = "25.12.0"
  description = "Kdenlive video editor"
  license = "GPL-3.0"
  homepage = "https://kdenlive.org"
  binary {
    url = "https://download.kde.org/stable/kdenlive/25.12/linux/kdenlive-25.12.0-x86_64.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/kdenlive ${destdir}/bin"
    command "cp ${srcdir}/kdenlive-25.12.0-x86_64.AppImage ${destdir}/opt/kdenlive/kdenlive.AppImage"
    command "chmod +x ${destdir}/opt/kdenlive/kdenlive.AppImage"
    command "ln -sf ../opt/kdenlive/kdenlive.AppImage ${destdir}/bin/kdenlive"
  }
}
