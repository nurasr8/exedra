package "shotcut" {
  version = "25.12.15"
  description = "Shotcut video editor"
  license = "GPL-3.0"
  homepage = "https://shotcut.org"
  binary {
    url = "https://github.com/mltframework/shotcut/releases/download/v25.12.15/shotcut-linux-x86_64-251215.txz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/shotcut ${destdir}/bin"
    command "tar -xf ${srcdir}/shotcut-linux-x86_64-251215.txz -C ${destdir}/opt/shotcut"
    command "chmod +x ${destdir}/opt/shotcut/Shotcut.app/bin/shotcut"
    command "ln -sf ../opt/shotcut/Shotcut.app/bin/shotcut ${destdir}/bin/shotcut"
  }
}
