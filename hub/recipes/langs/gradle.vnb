package "gradle" {
  version = "8.14.3"
  description = "Gradle"
  license = "Apache-2.0"
  homepage = "https://gradle.org"
  binary {
    url = "https://services.gradle.org/distributions/gradle-8.14.3-bin.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./gradle-8.14.3/bin/gradle ${destdir}/bin/gradle"
    command "chmod +x ${destdir}/bin/gradle"
  }
}
