package "ninja" {
  version = "1.13.2"
  description = "Ninja build"
  license = "Apache-2.0"
  homepage = "https://ninja-build.org"
  binary {
    url = "https://github.com/ninja-build/ninja/releases/download/v1.13.2/ninja-linux.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./ninja ${destdir}/bin/ninja"
    command "chmod +x ${destdir}/bin/ninja"
  }
}
