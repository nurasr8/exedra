package "opentofu" {
  version = "1.11.3"
  description = "OpenTofu"
  license = "MPL-2.0"
  homepage = "https://opentofu.org"
  binary {
    url = "https://github.com/opentofu/opentofu/releases/download/v1.11.3/tofu_1.11.3_linux_amd64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/opentofu ${destdir}/bin"
    command "tar -xf ${srcdir}/tofu_1.11.3_linux_amd64.tar.gz -C ${destdir}/opt/opentofu"
    command "chmod +x ${destdir}/opt/opentofu/tofu"
    command "ln -sf ../opt/opentofu/tofu ${destdir}/bin/opentofu"
  }
}
