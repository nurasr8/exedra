package "lazygit" {
  version = "0.55.1"
  description = "lazygit"
  license = "MIT"
  homepage = "https://github.com/jesseduffield/lazygit"
  binary {
    url = "https://github.com/jesseduffield/lazygit/releases/download/v0.55.1/lazygit_0.55.1_Linux_x86_64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/lazygit ${destdir}/bin"
    command "tar -xf ${srcdir}/lazygit_0.55.1_Linux_x86_64.tar.gz -C ${destdir}/opt/lazygit"
    command "chmod +x ${destdir}/opt/lazygit/lazygit"
    command "ln -sf ../opt/lazygit/lazygit ${destdir}/bin/lazygit"
  }
}
