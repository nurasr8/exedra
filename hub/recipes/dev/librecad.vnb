package "librecad" {
  version = "2.2.1"
  description = "LibreCAD 2D"
  license = "GPL-2.0"
  homepage = "https://librecad.org"
  binary {
    url = "https://github.com/LibreCAD/LibreCAD/releases/download/v2.2.1.5/LibreCAD-v2.2.1.5-x86_64.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/librecad ${destdir}/bin"
    command "cp ${srcdir}/LibreCAD-v2.2.1.5-x86_64.AppImage ${destdir}/opt/librecad/librecad.AppImage"
    command "chmod +x ${destdir}/opt/librecad/librecad.AppImage"
    command "ln -sf ../opt/librecad/librecad.AppImage ${destdir}/bin/librecad"
  }
}
