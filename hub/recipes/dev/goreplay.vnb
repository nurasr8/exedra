package "goreplay" {
  version = "1.3.4"
  description = "GoReplay"
  license = "MIT"
  homepage = "https://github.com/buger/goreplay"
  binary {
    url = "https://github.com/buger/goreplay/releases/download/v1.3.4/gor_1.3.4_x64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/goreplay ${destdir}/bin"
    command "tar -xf ${srcdir}/gor_1.3.4_x64.tar.gz -C ${destdir}/opt/goreplay"
    command "chmod +x ${destdir}/opt/goreplay/gor"
    command "ln -sf ../opt/goreplay/gor ${destdir}/bin/goreplay"
  }
}
