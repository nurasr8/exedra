package "hivemind" {
  version = "1.1.0"
  description = "Hivemind procman"
  license = "MIT"
  homepage = "https://github.com/DarthSim/hivemind"
  binary {
    url = "https://github.com/DarthSim/hivemind/releases/download/v1.1.0/hivemind-v1.1.0-linux-amd64.gz"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./hivemind-v1.1.0-linux-amd64 ${destdir}/bin/hivemind"
    command "chmod +x ${destdir}/bin/hivemind"
  }
}
