package "buf" {
  version = "1.57.2"
  description = "Buf protobuf"
  license = "Apache-2.0"
  homepage = "https://github.com/bufbuild/buf"
  binary {
    url = "https://github.com/bufbuild/buf/releases/download/v1.57.2/buf-Linux-x86_64"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./buf-Linux-x86_64 ${destdir}/bin/buf"
    command "chmod +x ${destdir}/bin/buf"
  }
}
