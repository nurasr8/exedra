package "orcaslicer" {
  version = "2.4.2"
  description = "OrcaSlicer 3D"
  license = "AGPL-3.0"
  homepage = "https://github.com/SoftFever/OrcaSlicer"
  binary {
    url = "https://github.com/SoftFever/OrcaSlicer/releases/download/v2.4.2/OrcaSlicer_Linux_AppImage_Ubuntu2404_V2.4.2.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/orcaslicer ${destdir}/bin"
    command "cp ${srcdir}/OrcaSlicer_Linux_AppImage_Ubuntu2404_V2.4.2.AppImage ${destdir}/opt/orcaslicer/orcaslicer.AppImage"
    command "chmod +x ${destdir}/opt/orcaslicer/orcaslicer.AppImage"
    command "ln -sf ../opt/orcaslicer/orcaslicer.AppImage ${destdir}/bin/orcaslicer"
  }
}
