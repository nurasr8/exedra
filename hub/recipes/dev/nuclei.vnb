package "nuclei" {
  version = "3.11.1"
  description = "nuclei scanner"
  license = "MIT"
  homepage = "https://github.com/projectdiscovery/nuclei"
  binary {
    url = "https://github.com/projectdiscovery/nuclei/releases/download/v3.11.1/nuclei_3.11.1_linux_amd64.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./nuclei ${destdir}/bin/nuclei"
    command "chmod +x ${destdir}/bin/nuclei"
  }
}
