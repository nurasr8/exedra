package "eww" {
  version = "0.6.0"
  description = "Eww widgets"
  license = "MIT"
  homepage = "https://github.com/elkowar/eww"
  binary {
    url = "https://github.com/elkowar/eww/releases/download/v0.6.0/eww-v0.6.0-x86_64-unknown-linux-musl.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/eww ${destdir}/bin"
    command "tar -xf ${srcdir}/eww-v0.6.0-x86_64-unknown-linux-musl.tar.gz -C ${destdir}/opt/eww"
    command "chmod +x ${destdir}/opt/eww/eww"
    command "ln -sf ../opt/eww/eww ${destdir}/bin/eww"
  }
}
