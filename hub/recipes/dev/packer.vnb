package "packer" {
  version = "1.14.2"
  description = "Packer"
  license = "BSL-1.1"
  homepage = "https://packer.io"
  binary {
    url = "https://releases.hashicorp.com/packer/1.14.2/packer_1.14.2_linux_amd64.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./packer ${destdir}/bin/packer"
    command "chmod +x ${destdir}/bin/packer"
  }
}
