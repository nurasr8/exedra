package "age" {
  version = "1.3.1"
  description = "age encryption"
  license = "BSD-3"
  homepage = "https://github.com/FiloSottile/age"
  binary {
    url = "https://github.com/FiloSottile/age/releases/download/v1.3.1/age-v1.3.1-linux-amd64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/age ${destdir}/bin"
    command "tar -xf ${srcdir}/age-v1.3.1-linux-amd64.tar.gz -C ${destdir}/opt/age"
    command "chmod +x ${destdir}/opt/age/age"
    command "ln -sf ../opt/age/age ${destdir}/bin/age"
    command "chmod +x ${destdir}/opt/age/age-keygen"
    command "ln -sf ../opt/age/age-keygen ${destdir}/bin/age-keygen"
  }
}
