package "tilt" {
  version = "0.37.7"
  description = "Tilt"
  license = "Apache-2.0"
  homepage = "https://tilt.dev"
  binary {
    url = "https://github.com/tilt-dev/tilt/releases/download/v0.37.7/tilt.0.37.7.linux.x86_64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/tilt ${destdir}/bin"
    command "tar -xf ${srcdir}/tilt.0.37.7.linux.x86_64.tar.gz -C ${destdir}/opt/tilt"
    command "chmod +x ${destdir}/opt/tilt/tilt"
    command "ln -sf ../opt/tilt/tilt ${destdir}/bin/tilt"
  }
}
