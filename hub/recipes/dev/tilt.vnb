package "tilt" {
  version = "0.34.3"
  description = "Tilt"
  license = "Apache-2.0"
  homepage = "https://tilt.dev"
  binary {
    url = "https://github.com/tilt-dev/tilt/releases/download/v0.34.3/tilt.0.34.3.linux.x86_64.gz"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./tilt.0.34.3.linux.x86_64 ${destdir}/bin/tilt"
    command "chmod +x ${destdir}/bin/tilt"
  }
}
