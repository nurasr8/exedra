package "httpx" {
  version = "1.12.0"
  description = "httpx probe"
  license = "MIT"
  homepage = "https://github.com/projectdiscovery/httpx"
  binary {
    url = "https://github.com/projectdiscovery/httpx/releases/download/v1.12.0/httpx_1.12.0_linux_amd64.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./httpx ${destdir}/bin/httpx"
    command "chmod +x ${destdir}/bin/httpx"
  }
}
