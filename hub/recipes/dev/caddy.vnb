package "caddy" {
  version = "2.10.2"
  description = "Caddy server"
  license = "Apache-2.0"
  homepage = "https://github.com/caddyserver/caddy"
  binary {
    url = "https://github.com/caddyserver/caddy/releases/download/v2.10.2/caddy_2.10.2_linux_amd64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/caddy ${destdir}/bin"
    command "tar -xf ${srcdir}/caddy_2.10.2_linux_amd64.tar.gz -C ${destdir}/opt/caddy"
    command "chmod +x ${destdir}/opt/caddy/caddy"
    command "ln -sf ../opt/caddy/caddy ${destdir}/bin/caddy"
  }
}
