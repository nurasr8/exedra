package "flux" {
  version = "2.7.3"
  description = "Flux CLI"
  license = "Apache-2.0"
  homepage = "https://fluxcd.io"
  binary {
    url = "https://github.com/fluxcd/flux2/releases/download/v2.7.3/flux_2.7.3_linux_amd64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/flux ${destdir}/bin"
    command "tar -xf ${srcdir}/flux_2.7.3_linux_amd64.tar.gz -C ${destdir}/opt/flux"
    command "chmod +x ${destdir}/opt/flux/flux"
    command "ln -sf ../opt/flux/flux ${destdir}/bin/flux"
  }
}
