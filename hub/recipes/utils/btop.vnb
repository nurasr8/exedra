package "btop" {
  version = "1.4.4"
  description = "btop monitor"
  license = "Apache-2.0"
  homepage = "https://github.com/aristocratos/btop"
  binary {
    url = "https://github.com/aristocratos/btop/releases/download/v1.4.4/btop-x86_64-linux-musl.tbz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/btop ${destdir}/bin"
    command "tar -xf ${srcdir}/btop-x86_64-linux-musl.tbz -C ${destdir}/opt/btop"
    command "chmod +x ${destdir}/opt/btop/bin/btop"
    command "ln -sf ../opt/btop/bin/btop ${destdir}/bin/btop"
  }
}
