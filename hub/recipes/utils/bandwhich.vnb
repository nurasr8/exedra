package "bandwhich" {
  version = "0.23.2"
  description = "bandwhich net"
  license = "MIT"
  homepage = "https://github.com/imsnif/bandwhich"
  binary {
    url = "https://github.com/imsnif/bandwhich/releases/download/bandwhich-v0.23.2/bandwhich-v0.23.2-x86_64-unknown-linux-musl.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/bandwhich ${destdir}/bin"
    command "tar -xf ${srcdir}/bandwhich-v0.23.2-x86_64-unknown-linux-musl.tar.gz -C ${destdir}/opt/bandwhich"
    command "chmod +x ${destdir}/opt/bandwhich/bandwhich"
    command "ln -sf ../opt/bandwhich/bandwhich ${destdir}/bin/bandwhich"
  }
}
