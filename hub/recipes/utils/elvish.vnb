package "elvish" {
  version = "0.21.0"
  description = "Elvish shell"
  license = "BSD-2"
  homepage = "https://elv.sh"
  binary {
    url = "https://github.com/elves/elvish/releases/download/v0.21.0/elvish-v0.21.0-linux-amd64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/elvish ${destdir}/bin"
    command "tar -xf ${srcdir}/elvish-v0.21.0-linux-amd64.tar.gz -C ${destdir}/opt/elvish"
    command "chmod +x ${destdir}/opt/elvish/elvish"
    command "ln -sf ../opt/elvish/elvish ${destdir}/bin/elvish"
  }
}
