package "procs" {
  version = "0.14.10"
  description = "procs ps"
  license = "MIT"
  homepage = "https://github.com/dalancey/procs"
  binary {
    url = "https://github.com/dalancey/procs/releases/download/v0.14.10/procs-0.14.10-x86_64-linux.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./procs ${destdir}/bin/procs"
    command "chmod +x ${destdir}/bin/procs"
  }
}
