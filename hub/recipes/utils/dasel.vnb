package "dasel" {
  version = "3.11.2"
  description = "dasel data tool"
  license = "MIT"
  homepage = "https://github.com/TomWright/dasel"
  binary {
    url = "https://github.com/TomWright/dasel/releases/download/v3.11.2/dasel_linux_amd64"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./dasel_linux_amd64 ${destdir}/bin/dasel"
    command "chmod +x ${destdir}/bin/dasel"
  }
}
