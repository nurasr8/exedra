package "superfile" {
  version = "1.6.0"
  description = "superfile manager"
  license = "MIT"
  homepage = "https://github.com/yorukot/superfile"
  binary {
    url = "https://github.com/yorukot/superfile/releases/download/v1.6.0/superfile-linux-v1.6.0-amd64.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/superfile ${destdir}/bin"
    command "tar -xf ${srcdir}/superfile-linux-v1.6.0-amd64.tar.gz -C ${destdir}/opt/superfile"
    command "chmod +x ${destdir}/opt/superfile/spf"
    command "ln -sf ../opt/superfile/spf ${destdir}/bin/superfile"
  }
}
