package "cpufetch" {
  version = "1.07"
  description = "cpufetch"
  license = "MIT"
  homepage = "https://github.com/Dr-Noob/cpufetch"
  binary {
    url = "https://github.com/Dr-Noob/cpufetch/releases/download/v1.07/cpufetch_x86-64_linux"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./cpufetch_x86-64_linux ${destdir}/bin/cpufetch"
    command "chmod +x ${destdir}/bin/cpufetch"
  }
}
