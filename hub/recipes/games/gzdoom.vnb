package "gzdoom" {
  version = "4.14.2"
  description = "GZDoom"
  license = "GPL-3.0"
  homepage = "https://zdoom.org"
  binary {
    url = "https://github.com/ZDoom/gzdoom/releases/download/g4.14.2/gzdoom-4-14-2-Linux.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/gzdoom ${destdir}/bin"
    command "tar -xf ${srcdir}/gzdoom-4-14-2-Linux.tar.gz -C ${destdir}/opt/gzdoom"
    command "chmod +x ${destdir}/opt/gzdoom/gzdoom"
    command "ln -sf ../opt/gzdoom/gzdoom ${destdir}/bin/gzdoom"
  }
}
