package "protonup-qt" {
  version = "2.12.0"
  description = "ProtonUp-Qt"
  license = "GPL-3.0"
  homepage = "https://github.com/DavidoTek/ProtonUp-Qt"
  binary {
    url = "https://github.com/DavidoTek/ProtonUp-Qt/releases/download/v2.12.0/pupgui2-2.12.0-x86_64.AppImage"
    format = "appimage"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/protonup-qt ${destdir}/bin"
    command "cp ${srcdir}/pupgui2-2.12.0-x86_64.AppImage ${destdir}/opt/protonup-qt/protonup-qt.AppImage"
    command "chmod +x ${destdir}/opt/protonup-qt/protonup-qt.AppImage"
    command "ln -sf ../opt/protonup-qt/protonup-qt.AppImage ${destdir}/bin/protonup-qt"
  }
}
