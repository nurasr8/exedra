package "godot" {
  version = "4.6"
  description = "Godot engine"
  license = "MIT"
  homepage = "https://godotengine.org"
  binary {
    url = "https://github.com/godotengine/godot/releases/download/4.6-stable/Godot_v4.6-stable_linux.x86_64.zip"
    format = "single"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/bin"
    command "cp ./Godot_v4.6-stable_linux.x86_64 ${destdir}/bin/godot"
    command "chmod +x ${destdir}/bin/godot"
  }
}
