package "micro" {
  version = "2.0.14"
  description = "micro editor"
  license = "MIT"
  homepage = "https://micro-editor.github.io"
  binary {
    url = "https://github.com/zyedidia/micro/releases/download/v2.0.14/micro-2.0.14-linux64-static.tar.gz"
    format = "tarball"
  }
  depends {
    "glibc"
  }
  install {
    command "mkdir -p ${destdir}/opt/micro ${destdir}/bin"
    command "tar -xf ${srcdir}/micro-2.0.14-linux64-static.tar.gz -C ${destdir}/opt/micro --strip-components=1"
    command "chmod +x ${destdir}/opt/micro/micro"
    command "ln -sf ../opt/micro/micro ${destdir}/bin/micro"
  }
}
